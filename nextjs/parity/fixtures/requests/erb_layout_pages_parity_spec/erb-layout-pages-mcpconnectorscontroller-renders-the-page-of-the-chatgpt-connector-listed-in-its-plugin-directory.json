\n  </div>\n\n  <div class=\"flex items-center lg:hidden\"><button class=\"relative flex h-8 w-8 flex-col all-unset items-center justify-center focus:outline-hidden\" data-toggle=\"mobile-menu\"><div class=\"mb-1 h-0.5 w-8 origin-center bg-black transition-transform duration-200 dark:bg-white\" data-menu-line=\"1\"></div><div class=\"mt-1 h-0.5 w-8 origin-center bg-black transition-transform duration-200 dark:bg-white\" data-menu-line=\"2\"></div></button></div>\n</div>\n<div class=\"override hidden justify-between border-b border-black flex-col top-20 left-0 right-0 z-50 fixed bg-black dark:border-white/35\" id=\"mobile-menu\">\n  <div class=\"flex flex-col justify-center items-center lg:flex-row lg:gap-1 lg:px-6\"><a class=\"flex w-full items-center justify-center border border-transparent lg:bg-transparent lg:text-black dark:lg:text-white bg-black p-4 text-lg text-white no-underline transition-all duration-200 hover:border-black lg:w-auto lg:rounded-full lg:py-2 lg:px-4 dark:text-white lg:dark:hover:border-white/35 whitespace-nowrap\" href=\"/discover\">Discover</a><a class=\"flex w-full items-center justify-center border border-transparent lg:bg-transparent lg:text-black dark:lg:text-white bg-black p-4 text-lg text-white no-underline transition-all duration-200 hover:border-black lg:w-auto lg:rounded-full lg:py-2 lg:px-4 dark:text-white lg:dark:hover:border-white/35 whitespace-nowrap\" href=\"/blog\">Blog</a><a class=\"flex w-full items-center justify-center border border-transparent lg:bg-transparent lg:text-black dark:lg:text-white bg-black p-4 text-lg text-white no-underline transition-all duration-200 hover:border-black lg:w-auto lg:rounded-full lg:py-2 lg:px-4 dark:text-white lg:dark:hover:border-white/35 whitespace-nowrap\" href=\"/pricing\">Pricing</a><a class=\"flex w-full items-center justify-center border border-transparent lg:bg-transparent lg:text-black dark:lg:text-white bg-black p-4 text-lg text-white no-underline transition-all duration-200 hover:border-black lg:w-auto lg:rounded-full lg:py-2 lg:px-4 dark:text-white lg:dark:hover:border-white/35 whitespace-nowrap\" href=\"/features\">Features</a><a class=\"flex w-full items-center justify-center border border-transparent lg:bg-transparent lg:text-black dark:lg:text-white bg-black p-4 text-lg text-white no-underline transition-all duration-200 hover:border-black lg:w-auto lg:rounded-full lg:py-2 lg:px-4 dark:text-white lg:dark:hover:border-white/35 whitespace-nowrap\" href=\"/about\">About</a><a class=\"flex w-full items-center justify-center border border-transparent lg:bg-transparent lg:text-black dark:lg:text-white bg-black p-4 text-lg text-white no-underline transition-all duration-200 hover:border-black lg:w-auto lg:rounded-full lg:py-2 lg:px-4 dark:text-white lg:dark:hover:border-white/35 whitespace-nowrap\" href=\"/gumclaw\">Gumclaw</a></div>\n  <div class=\"flex flex-col lg:flex-row lg:h-full\"><a class=\"flex w-full items-center justify-center h-full lg:border-l-black lg:bg-white lg:text-black lg:hover:bg-pink dark:lg:border-l-white/35 dark:lg:bg-black dark:lg:text-white border-black bg-black p-4 text-lg text-white no-underline transition-colors duration-200 hover:bg-pink hover:text-black lg:w-auto lg:border-l lg:py-2 lg:px-6 whitespace-nowrap dark:lg:hover:bg-white dark:lg:hover:text-black\" href=\"/login\">Log in</a><a class=\"flex w-full items-center justify-center h-full lg:bg-black lg:text-white lg:hover:bg-pink border-black bg-black p-4 text-lg text-white no-underline transition-colors duration-200 hover:bg-pink hover:text-black lg:w-auto lg:border-l lg:py-2 lg:px-6 whitespace-nowrap dark:bg-pink dark:text-black dark:hover:bg-white dark:lg:bg-pink dark:lg:text-black dark:lg:hover:bg-white\" href=\"/signup\">Start selling</a></div>\n</div>\n\n    <div class=\"overflow-hidden\">\n      <div class=\"min-h-screen\">\n  <header class=\"grid border-b border-black lg:grid-cols-2\">\n    <div class=\"flex flex-col justify-center gap-8 bg-pink px-8 py-16 text-black lg:px-16 lg:py-24\">\n      <p class=\"text-xl\">Sell digital products with AI</p>\n      <h1 class=\"text-5xl font-medium leading-none text-balance sm:text-6xl xl:text-7xl\">Gumroad MCP<br>for ChatGPT</h1>\n        <p class=\"max-w-xl text-xl sm:text-2xl\">Connect your Gumroad store to ChatGPT. Create product drafts, check sales, and track payouts from your chat.</p>\n        <p class=\"max-w-xl text-lg\">Listed in ChatGPT’s plugin directory.</p>\n      <div class=\"flex flex-col items-start gap-5\">\n        \n<div class=\"relative inline-block group\">\n  <div class=\"absolute inset-0 rounded-sm bg-yellow border border-black transition-transform duration-150 z-2\"></div>\n  <div class=\"absolute inset-0 rounded-sm bg-red border border-black transition-transform duration-150 group-hover:translate-x-2 group-hover:translate-y-2 z-1\"></div>\n    <a class=\"relative inline-flex rounded-sm no-underline items-center justify-center border border-black transition-all duration-150 group-hover:-translate-x-2 group-hover:-translate-y-2 z-3 w-full lg:w-auto cursor-pointer h-14 px-8 text-xl lg:h-16 lg:px-10 lg:text-xl bg-white text-black\" href=\"https://chatgpt.com/plugins/plugin_asdk_app_6adf8e8e7eac8191a9af1b87fdeedb45\">\n      Add Gumroad to ChatGPT\n</a></div>\n\n          <p class=\"text-base\">You’ll need a Gumroad account and MCP support in ChatGPT.</p>\n      </div>\n    </div>\n    <div class=\"hidden items-center justify-center border-l border-black bg-yellow px-12 py-12 text-black lg:flex\">\n      <img alt=\"A smiling Gumroad creator working on a laptop\" width=\"525\" height=\"524\" class=\"h-auto w-full max-w-md\" src=\"/images/mcp/creator.svg\" />\n    </div>\n  </header>\n\n  <section class=\"px-8 py-16 lg:px-16 lg:py-24\" aria-labelledby=\"capabilities-title\">\n    <div class=\"mx-auto max-w-7xl\">\n      <div class=\"mb-12 max-w-3xl space-y-6\">\n        <p class=\"text-xl\">An MCP server for selling digital products</p>\n        <h2 id=\"capabilities-title\" class=\"text-4xl font-medium text-balance md:text-6xl\">What can you do with ChatGPT?</h2>\n        <p class=\"text-lg\">Use Model Context Protocol (MCP) to connect your AI assistant to your store. Manage ebooks, templates, courses, and other digital products.</p>\n      </div>\n      <div class=\"grid gap-10 md:grid-cols-3\">\n        <article class=\"space-y-5\">\n          <div class=\"flex h-56 items-center justify-center rounded-xl border border-black bg-yellow p-8\">\n            <img alt=\"\" class=\"h-full w-full object-contain\" loading=\"lazy\" src=\"/images/features/sales-graph.svg\" />\n          </div>\n          <h3 class=\"text-2xl font-medium\">“Show my recent sales.”</h3>\n          <p class=\"text-lg\">See which products people bought and what they paid.</p>\n        </article>\n        <article class=\"space-y-5\">\n          <div class=\"flex h-56 items-center justify-center rounded-xl border border-black bg-pink p-8\">\n            <img alt=\"\" class=\"h-full w-full object-contain\" loading=\"lazy\" src=\"/images/features/books-and-writing.svg\" />\n          </div>\n          <h3 class=\"text-2xl font-medium\">“Draft my next product.”</h3>\n          <p class=\"text-lg\">Ask for a product name, price, and description. Add the product files in Gumroad before publishing.</p>\n        </article>\n        <article class=\"space-y-5\">\n          <div class=\"flex h-56 items-center justify-center rounded-xl border border-black bg-purple p-8\">\n            <img alt=\"\" class=\"h-full w-full object-contain\" loading=\"lazy\" src=\"/images/about/coin-5.svg\" />\n          </div>\n          <h3 class=\"text-2xl font-medium\">“Check my latest payouts.”</h3>\n          <p class=\"text-lg\">Check recent payout amounts and their status.</p>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"connect\" class=\"scroll-mt-28 border-y border-black bg-dark-gray px-8 py-16 text-white lg:px-16 lg:py-24\" aria-labelledby=\"connect-title\">\n    <div class=\"mx-auto grid max-w-7xl gap-12 lg:grid-cols-2 lg:gap-20\">\n      <div class=\"space-y-6\">\n        <p class=\"text-xl text-pink\">Set up Gumroad MCP</p>\n        <h2 id=\"connect-title\" class=\"text-4xl font-medium text-balance md:text-6xl\">How do you connect ChatGPT?</h2>\n        <p class=\"max-w-xl text-lg\">Add Gumroad from ChatGPT’s plugin directory.</p>\n      </div>\n        <ol class=\"list-none space-y-8 pl-0\">\n          <li class=\"space-y-4\">\n            <h3 class=\"text-2xl font-medium\">1. Add the connector</h3>\n            <p class=\"text-lg\">Open Gumroad in ChatGPT’s plugin directory and connect it. If you cannot add plugins, ask your workspace administrator.</p>\n              <a class=\"block text-lg underline underline-offset-4\" href=\"https://chatgpt.com/plugins/plugin_asdk_app_6adf8e8e7eac8191a9af1b87fdeedb45\">Gumroad in ChatGPT’s plugin directory</a>\n            <div class=\"rounded-lg border border-white/35 p-5\">\n              <p class=\"mb-2 text-sm text-pink\">MCP server URL</p>\n              <code class=\"block select-all break-all text-base\">http://app.test.gumroad.com:31337/chatgpt/v1/mcp</code>\n            </div>\n          </li>\n          <li class=\"space-y-3\">\n            <h3 class=\"text-2xl font-medium\">2. Connect your Gumroad account</h3>\n            <p class=\"text-lg\">Sign in to Gumroad when prompted. Review the requested permissions before you authorize access.</p>\n          </li>\n          <li class=\"space-y-3\">\n            <h3 class=\"text-2xl font-medium\">3. Start a conversation</h3>\n            <p class=\"text-lg\">Select the connector in your chat. Try asking, “Show my Gumroad products.”</p>\n          </li>\n        </ol>\n    </div>\n  </section>\n\n  <section class=\"px-8 py-16 lg:px-16 lg:py-24\" aria-labelledby=\"access-title\">\n    <div class=\"mx-auto grid max-w-7xl gap-12 lg:grid-cols-2 lg:gap-20\">\n      <h2 id=\"access-title\" class=\"text-4xl font-medium text-balance md:text-6xl\">What access do you give ChatGPT?</h2>\n      <div class=\"space-y-8 text-lg\">\n        <div class=\"space-y-3\">\n          <h3 class=\"text-2xl font-medium\">What data can it read?</h3>\n          <p>The connector can access your products, sales, buyer emails, and payouts according to the permissions you grant.</p>\n        </div>\n        <div class=\"space-y-3\">\n          <h3 class=\"text-2xl font-medium\">Can it publish products?</h3>\n          <p>New products start as unpublished drafts. With product access, the connector can publish or unpublish them. Review these actions in your MCP client.</p>\n        </div>\n        <div class=\"space-y-3\">\n          <h3 class=\"text-2xl font-medium\">How do customers buy?</h3>\n          <p>Share your product’s Gumroad link. Customers pay through Gumroad checkout. The MCP server does not take payments in your chat.</p>\n        </div>\n        <div class=\"space-y-3\">\n          <h3 class=\"text-2xl font-medium\">How do I revoke access?</h3>\n          <p>Revoke the connection any time in <a href=\"/settings/authorized_applications\">Settings &gt; Applications</a>. Disconnecting the connector in your chat app does not revoke its access token, so revoke it here to end the connection.</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <div class=\"border-t border-black dark:border-white/35 px-8 py-10 lg:px-16\">\n    <div class=\"mx-auto flex max-w-7xl flex-col justify-between gap-6 md:flex-row\">\n      <nav aria-label=\"Other connectors\" class=\"flex flex-wrap items-center gap-x-6 gap-y-2\">\n        <span>Other connector details</span>\n          <a class=\"inline-flex min-h-11 items-center underline underline-offset-4\" href=\"/muse\">Gumroad MCP for Muse</a>\n          <a class=\"inline-flex min-h-11 items-center underline underline-offset-4\" href=\"/claude\">Gumroad MCP for Claude</a>\n          <a class=\"inline-flex min-h-11 items-center underline underline-offset-4\" href=\"/cursor\">Gumroad MCP for Cursor</a>\n          <a class=\"inline-flex min-h-11 items-center underline underline-offset-4\" href=\"/antigravity\">Gumroad MCP for Google Antigravity</a>\n        <a class=\"inline-flex min-h-11 items-center underline underline-offset-4\" href=\"/mcp\">All connectors</a>\n      </nav>\n      <nav aria-label=\"Developer resources\" class=\"flex flex-wrap items-center gap-6\">\n        <a class=\"inline-flex min-h-11 items-center underline underline-offset-4\" href=\"https://gumroad.com/help/article/355-connect-ai-assistants-to-gumroad\">Setup guide</a>\n        <a class=\"inline-flex min-h-11 items-center underline underline-offset-4\" href=\"/api\">API docs</a>\n        <a class=\"inline-flex min-h-11 items-center underline underline-offset-4\" href=\"/.well-known/mcp.json\">MCP discovery</a>\n      </nav>\n    </div>\n  </div>\n  <div class=\"flex flex-col justify-between gap-16 bg-black text-white py-16 px-8 lg:flex-row lg:px-[4vw] lg:py-24 leading-relaxed\">\n  <div class=\"max-w-3xl flex flex-col gap-16 w-full\">\n    <div class=\"flex flex-col gap-8\">\n      <div class=\"text-3xl lg:leading-tight lg:text-5xl\">Subscribe to get tips and tactics to grow the way you want.</div>\n      <form action=\"https://gumroad.com/follow_from_embed_form\" method=\"post\" class=\"flex gap-1\">\n        <input name=\"seller_id\" type=\"hidden\" value=\"6282492303727\">\n        <div class=\"lg:flex-1\">\n          <input name=\"email\" placeholder=\"Your email address\" type=\"email\" class=\"w-full h-12 px-4 rounded border border-white/30 bg-transparent text-white placeholder-white/50 focus:outline-none focus:ring-1 focus:ring-accent focus:border-accent font-[inherit] text-base\">\n        </div>\n        \n<div class=\"relative inline-block group\">\n  <div class=\"absolute inset-0 rounded-sm bg-yellow border border-black transition-transform duration-150 z-2\"></div>\n  <div class=\"absolute inset-0 rounded-sm bg-red border border-black transition-transform duration-150 group-hover:translate-x-2 group-hover:translate-y-2 z-1\"></div>\n    <button name=\"button\" type=\"submit\" class=\"relative inline-flex rounded-sm no-underline items-center justify-center border border-black transition-all duration-150 group-hover:-translate-x-2 group-hover:-translate-y-2 z-3 w-full lg:w-auto cursor-pointer h-12 px-3 text-base lg:h-12 lg:px-6 lg:text-base bg-pink text-black\">\n      →\n</button></div>\n\n      </form>\n    </div>\n    <div class=\"flex items-center gap-2\">\n      <img alt=\"Gumroad icon\" class=\"w-6 h-6\" src=\"/images/logo-g.svg\" />\n      <div>Ⓒ Gumroad, Inc.</div>\n    </div>\n  </div>\n  <div class=\"max-w-3xl flex flex-col w-full gap-16\">\n    <div class=\"flex-1 flex gap-16\">\n      <div class=\"flex-1 flex flex-col gap-3\">\n        <a class=\"no-underline hover:text-pink\" href=\"/discover\">Discover</a>\n        <a class=\"no-underline hover:text-pink\" href=\"/blog\">Blog</a>\n        <a class=\"no-underline hover:text-pink\" href=\"/pricing\">Pricing</a>\n        <a class=\"no-underline hover:text-pink\" href=\"/features\">Features</a>\n        <a class=\"no-underline hover:text-pink\" href=\"/about\">About</a>\n        <a class=\"no-underline hover:text-pink\" href=\"/gumclaw\">Gumclaw</a>\n        <a class=\"no-underline hover:text-pink\" href=\"/small-bets\">Small Bets</a>\n        <a class=\"no-underline hover:text-pink\" href=\"/mcp\">Gumroad MCP</a>\n      </div>\n      <div class=\"flex-1 flex flex-col gap-3\">\n        <a class=\"no-underline hover:text-pink\" href=\"/help\">Help</a>\n        <a href=\"https://www.youtube.com/playlist?list=PL_DfN-mKCGNuswqERc6sIA8urYAKARc6s\" class=\"no-underline hover:text-pink\">Board meetings</a>\n        <a class=\"no-underline hover:text-pink\" href=\"/terms\">Terms of Service</a>\n        <a class=\"no-underline hover:text-pink\" href=\"/privacy\">Privacy Policy</a>\n      </div>\n    </div>\n    <div class=\"flex ju