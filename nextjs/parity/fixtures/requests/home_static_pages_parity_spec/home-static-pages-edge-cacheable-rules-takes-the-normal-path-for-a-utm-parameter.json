        "body": "\n\n<!DOCTYPE html>\n<html lang=\"en\">\n  <head prefix=\"og: http://ogp.me/ns# fb: http://ogp.me/ns/fb# : http://ogp.me/ns/fb/#\">\n    <link rel=\"dns-prefetch\" href=\"//test-static-2.gumroad.com\">\n    <link rel=\"dns-prefetch\" href=\"//test-public-files.gumroad.com\">\n  <meta name=\"action-cable-url\" content=\"/cable\" />\n  \n  \n  <link rel=\"stylesheet\" crossorigin=\"anonymous\" href=\"/vite-test/assets/entrypoints/design-DzT6_PG0.css\" />\n  \n  \n  <title inertia=\"title\">Prohibited products on Gumroad</title>\n<meta name=\"csrf-param\" content=\"authenticity_token\" inertia=\"meta-name-csrf-param\">\n<meta name=\"csrf-token\" content=\"xztYTJ6SEi8TmcE7ImImpELlN5jnVSBVQOrHxJQJ-mH-O5TMk-knYe5ulGtebKBWYjKQAsD2XJG4q6YgJY_vaA\" inertia=\"meta-name-csrf-token\">\n<meta charset=\"utf-8\" inertia=\"meta-charset\">\n<meta property=\"fb:app_id\" inertia=\"meta-property-fb-app_id\">\n<meta property=\"fb:page_id\" content=\"http://www.facebook.com/gumroad\" inertia=\"meta-property-fb-page_id\">\n<meta property=\"gr:environment\" content=\"test\" inertia=\"meta-property-gr-environment\">\n<meta property=\"og:image\" content=\"/images/opengraph_image.png\" inertia=\"meta-property-og-image\">\n<meta property=\"og:image:alt\" content=\"Gumroad\" inertia=\"meta-property-og-image-alt\">\n<meta property=\"og:title\" content=\"Prohibited products on Gumroad\" inertia=\"meta-property-og-title\">\n<meta property=\"og:site_name\" content=\"Gumroad\" inertia=\"meta-property-og-site_name\">\n<meta name=\"viewport\" content=\"initial-scale = 1.0, width = device-width\" inertia=\"meta-name-viewport\">\n<meta property=\"stripe:pk\" value=\"pk_test_51SNEgsIBOqvOFDrfzBydwy0Ca4j1Xgs7pQsbp2zsyWqHezN7yu3TRignvBqDEc6gn8y98bX8HRv8gKJ8Q45w2t6N00ofXBsMBF\" inertia=\"meta-property-stripe-pk\">\n<meta property=\"stripe:api_version\" value=\"2023-10-16\" inertia=\"meta-property-stripe-api_version\">\n<meta property=\"twitter:site\" content=\"@gumroad\" inertia=\"meta-prop