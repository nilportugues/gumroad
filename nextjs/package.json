{
  "name": "gumroad-next",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "typecheck": "node scripts/typecheck.ts",
    "test": "vitest run",
    "parity": "tsc -p parity && vitest run --config parity/vitest.config.ts",
    "prisma:generate-schema": "node scripts/schema-rb-to-prisma.ts ../db/schema.rb prisma/schema.prisma",
    "prisma:extract-associations": "cd .. && bundle exec ruby nextjs/scripts/extract-associations.rb",
    "prisma:check-drift": "node scripts/schema-rb-to-prisma.ts ../db/schema.rb prisma/schema.prisma && git diff --exit-code prisma/schema.prisma prisma/relations/manifest.json",
    "postinstall": "prisma generate",
    "jobs:generate": "node scripts/generate-job-registry.ts",
    "jobs:check-drift": "node scripts/generate-job-registry.ts --check",
    "worker": "node src/worker/index.ts"
  },
  "dependencies": {
    "@anycable/web": "1.1.0",
    "@aws-sdk/client-s3": "^3.1161.0",
    "@boxicons/react": "^1.0.3",
    "@elastic/elasticsearch": "^7.17.14",
    "@prisma/client": "^6.19.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@rails/activestorage": "7.2.100",
    "@sentry/node": "^10.78.0",
    "@stripe/react-stripe-js": "2.8.1",
    "@stripe/stripe-js": "4.7.0",
    "@tiptap/core": "2.6.5",
    "@tiptap/extension-character-count": "2.6.5",
    "@tiptap/extension-code-block-lowlight": "2.6.5",
    "@tiptap/extension-link": "2.6.5",
    "@tiptap/extension-placeholder": "2.6.5",
    "@tiptap/extension-underline": "2.6.5",
    "@tiptap/pm": "2.6.5",
    "@tiptap/react": "2.6.5",
    "@tiptap/starter-kit": "2.6.5",
    "autolinker": "4.0.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.5.3",
    "class-variance-authority": "^0.7.1",
    "classnames": "^2.3.2",
    "clipboard": "^2.0.11",
    "cn": "^0.2.6",
    "date-fns": "^3.0.0",
    "date-fns-tz": "3.2.0",
    "dompurify": "3.4.16",
    "immer": "10.1.1",
    "ioredis": "^6.0.0",
    "libphonenumber-js": "1.12.23",
    "lodash-es": "^4.18.1",
    "lowlight": "3.1.0",
    "mmdb-lib": "3.0.3",
    "next": "^16.0.0",
    "next-auth": "5.0.0-beta.32",
    "pako": "^2.2.0",
    "parse5": "^7.3.0",
    "react": "^19.2.0",
    "react-day-picker": "9.11.1",
    "react-dom": "^19.2.0",
    "react-media-recorder": "1.7.1",
    "react-router-dom": "6.26.2",
    "react-select": "5.8.1",
    "react-sortablejs": "6.1.4",
    "recharts": "2.15.2",
    "sortablejs": "1.15.3",
    "stripe": "^14.25.0",
    "tldts": "^7.4.19",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.0.0",
    "@types/pako": "^2.0.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "cron-parser": "^5.10.2",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.32",
    "prisma": "^6.19.0",
    "sass": "~1.77.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.0",
    "vitest": "^3.2.0",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "@tiptap/extension-blockquote": "$@tiptap/starter-kit",
    "@tiptap/extension-bold": "$@tiptap/starter-kit",
    "@tiptap/extension-bubble-menu": "$@tiptap/react",
    "@tiptap/extension-bullet-list": "$@tiptap/starter-kit",
    "@tiptap/extension-code-block": "$@tiptap/starter-kit",
    "@tiptap/extension-code": "$@tiptap/starter-kit",
    "@tiptap/extension-document": "$@tiptap/starter-kit",
    "@tiptap/extension-dropcursor": "$@tiptap/starter-kit",
