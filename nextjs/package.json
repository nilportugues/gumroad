{
  "name": "gumroad-next",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prisma:generate-schema": "node scripts/schema-rb-to-prisma.ts ../db/schema.rb prisma/schema.prisma",
    "prisma:check-drift": "node scripts/schema-rb-to-prisma.ts ../db/schema.rb prisma/schema.prisma && git diff --exit-code prisma/schema.prisma",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@boxicons/react": "^1.0.3",
    "@prisma/client": "^6.19.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "lodash-es": "^4.18.1",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tldts": "^7.4.19",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/react": "^16.3.3",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.32",
    "prisma": "^6.19.0",
    "sass": "~1.77.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.0",
    "vitest": "^3.2.0"
  }
}
